---
import Header from '../components/Header.astro';
import Profiles from '../components/Profiles.astro';
import Experience from '../components/Experience.astro'
import '../styles/global.css';
import ThemeIcon from "../components/ThemeIcon.astro";
const { pageTitle } = Astro.props;
const skillColor = "black";
const fontWeight =  "bold";
const textTransform = "capitalize";
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
</head>
<body>
    <ThemeIcon />
    <h1>{pageTitle}</h1>

    <Profiles />
    <h1>About me</h1>

    <ul>
        Tech lead for Python packages and open-source software, leading a team of 4 engineers. My work spans backend architecture, system
        design, and CI/CD merge criteria, with a focus on ensuring software reliability and performance before deployment. I work across engineering and research teams
        to turn technical requirements into production-ready systems.
    </ul>

    <Experience />
       <h1>Education</h1>
        <h2>University of Colorado Boulder</h2>
        <h3>Master of Science in Applied Mathematics (Aug 2018 - Dec 2020)</h3>

        <h2>University of Colorado Boulder</h2>
        <h3>Master of Science in Computer Science (Aug 2013 - Dec 2015)</h3>





<script>
    import "../scripts/menu.js";
</script>
</body>
</html>
